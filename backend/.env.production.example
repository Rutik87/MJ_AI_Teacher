# ==============================================================================
# MPSC AI Cloud Backend — Production Environment Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=production
PROJECT_NAME="MPSC AI Study Assistant"
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# Database Configuration (SQLite / PostgreSQL)
# For local persistent SQLite:
DATABASE_URL=sqlite:///./data/db/mpsc_study.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://mpsc_user:mpsc_secure_password@postgres_host:5432/mpsc_ai_db

# AI & LLM Provider Settings (Zero secrets exposed to Flutter client)
LLM_PROVIDER=gemini  # gemini, local, openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Local / Cloud Embedding Configuration
EMBEDDING_PROVIDER=sentence_transformers  # sentence_transformers, fastembed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Upload Paths
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/embeddings
AUDIO_OUTPUT_DIR=./data/audio

# Current Affairs & Background Sync Settings
CURRENT_AFFAIRS_SYNC_INTERVAL_HOURS=6
ENABLE_BACKGROUND_CRON=true
