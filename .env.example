# ==========================================
# MPSC AI Study Assistant — Configuration
# ==========================================

# AI & LLM Provider Settings
# Options: auto | gemini | openai | groq | ollama | offline
AI_PROVIDER=auto
AI_MODEL=gemini-1.5-flash
AI_API_KEY=

# Embeddings Configuration
# Options: auto | marathi_sentence | gemini | openai | local_tfidf
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///data/database/mpsc_study.db
VECTOR_DB_PATH=data/embeddings/vector_index.json

# Speech & Text to Speech
STT_PROVIDER=modular_marathi
TTS_PROVIDER=gtts
TTS_DEFAULT_LANG=mr

# Server Configuration
HOST=0.0.0.0
PORT=8000
